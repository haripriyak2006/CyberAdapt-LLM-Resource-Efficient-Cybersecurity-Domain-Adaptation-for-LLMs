# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets / environment ───────────────────────────────────────────────────
.env
*.pem
*.key
secrets/

# ── Model weights & large binaries ─────────────────────────────────────────
models/base/
models/adapted/
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.gguf

# ── Data (large files live outside git) ────────────────────────────────────
data/raw/
data/processed/
data/datasets/
*.parquet
*.arrow
*.csv

# Keep sample JSONL files (small, useful for demo); ignore large data JSONL
# Add any large JSONL explicitly if needed:
# data/processed/*.jsonl

# ── Vector stores ───────────────────────────────────────────────────────────
*.faiss
*.index
chroma/

# ── Evaluation results (generated, not source) ─────────────────────────────
evaluation/results/
# Allow the results directory structure but not JSON outputs
!evaluation/results/.gitkeep

# ── Logs & caches ───────────────────────────────────────────────────────────
logs/
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── HuggingFace cache ────────────────────────────────────────────────────────
~/.cache/huggingface/

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/

# ── Docker ───────────────────────────────────────────────────────────────────
# docker-compose.override.yml  (keep docker-compose.yml in git)

