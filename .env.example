# ── CyberAdapt-LLM  ·  Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.
# Priority: env vars > .env > configs/*.yaml > hard-coded defaults

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ─── Model ────────────────────────────────────────────────────────────────────
# PRIMARY model selector (Phase 2+). Overrides BASE_MODEL_ID if both set.
# Small CPU-safe options: distilgpt2  |  gpt2  |  TinyLlama/TinyLlama-1.1B-Chat-v1.0
BASE_MODEL_NAME=distilgpt2
# Legacy alias (still supported for backward compat)
# BASE_MODEL_ID=mistralai/Mistral-7B-v0.1
MODEL_CACHE_DIR=./models/base
ADAPTED_MODEL_DIR=./models/adapted
# Device: auto | cpu | cuda | mps
DEVICE=auto
# Max tokens for inference
MAX_NEW_TOKENS=256
TEMPERATURE=0.7
TOP_P=0.9
# Set to true to use float16 on CUDA (saves GPU memory, ignored on CPU/MPS)
USE_HALF_PRECISION=false

# ─── Training ────────────────────────────────────────────────────────────────
TRAINING_OUTPUT_DIR=./models/adapted
TRAINING_EPOCHS=3
TRAINING_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=2e-4
# LoRA / PEFT settings
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# ─── Data ─────────────────────────────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
DATASET_DIR=./data/datasets
CORPUS_FILE=./data/processed/cybersecurity_corpus.jsonl

# ─── Tokenization (Phase 4) ───────────────────────────────────────────────────
# Tokens per training sequence (power-of-2 values work best: 512, 1024, 2048)
MAX_SEQUENCE_LENGTH=1024
# Fraction of records assigned to training (rest goes to validation)
TRAIN_SPLIT_RATIO=0.9
# Random seed for reproducible shuffling and splitting
TOKENIZE_SEED=42
# Output directory for the HuggingFace Arrow datasets
TOKENIZED_DATA_DIR=./data/datasets/tokenized

# ─── Vector Store / RAG ───────────────────────────────────────────────────────
VECTOR_STORE_PATH=./data/datasets/faiss_index
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# ─── API Keys (optional integrations) ────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# NVD_API_KEY=...
# VIRUSTOTAL_API_KEY=...

# ─── Evaluation ───────────────────────────────────────────────────────────────
EVAL_OUTPUT_DIR=./evaluation/results
